meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "novo@exemplo.com",
    "nickname": "novo_user",
    "password": "Test@123",
    "name": "Novo Usuário",
    "birthDate": "1990-05-15",
    "sex": "male",
    "height": 175,
    "termsAccepted": true
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}
